# Copy this file to .env and fill in real values.
#   Windows:  Copy-Item .env.example .env
#
# .env is git-ignored and must never be committed.

# development | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Crawler identity -----------------------------------------------------
# Sent with every request so site owners can contact us instead of blocking us.
# CONTACT_URL should eventually be a real page explaining what the bot does.
CONTACT_EMAIL=you@example.com
CONTACT_URL=https://example.com/bot

# --- Crawler politeness ---------------------------------------------------
# Seconds between requests to the same site. Do not go below 1.0.
CRAWLER_DELAY_SECONDS=3.0
CRAWLER_TIMEOUT_SECONDS=30.0
CRAWLER_MAX_RETRIES=3
CRAWLER_RESPECT_ROBOTS=true
