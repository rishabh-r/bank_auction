# Copy this file to .env and fill in real values.
#   Windows:  Copy-Item .env.example .env
#
# .env is git-ignored and must never be committed.

# development | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Crawler identity -----------------------------------------------------
# Sent with every request so site owners can contact us instead of blocking us.
# CONTACT_URL should eventually be a real page explaining what the bot does.
CONTACT_EMAIL=you@example.com
CONTACT_URL=https://example.com/bot

# --- Crawler politeness ---------------------------------------------------
# Seconds between requests to the same site. Do not go below 1.0.
CRAWLER_DELAY_SECONDS=3.0
CRAWLER_TIMEOUT_SECONDS=30.0
CRAWLER_MAX_RETRIES=3
CRAWLER_RESPECT_ROBOTS=true

# URLs per source per scheduled run. At a 3-second delay, 1500 is about
# 75 minutes of crawling, four times a day. Lower it if a source asks us
# to slow down.
CRAWL_BATCH_SIZE=1500

# --- Database -------------------------------------------------------------
# Local development server, created by: python scripts/setup_postgres.py
# In production this points at a managed Postgres instance.
DATABASE_URL=postgresql+psycopg://postgres:devpassword@localhost:5433/auction_portal
TEST_DATABASE_URL=postgresql+psycopg://postgres:devpassword@localhost:5433/auction_portal_test
DB_ECHO=false

# --- Docker deployment only (see docs/DEPLOYMENT.md) -----------------------
# Used by docker-compose.yml. Ignored when running locally.
POSTGRES_PASSWORD=

# --- API keys -------------------------------------------------------------
# Not needed until Phase 2 (LLM extraction from PDF notices). Leave blank
# until then. Never paste a key anywhere except this file, which is
# git-ignored. If a key is ever pasted into a chat, email, ticket or commit,
# treat it as compromised and rotate it.
OPENAI_API_KEY=
