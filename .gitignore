# ---- Secrets -------------------------------------------------------------
# .env holds real credentials and must NEVER be committed.
# .env.example is committed and shows what keys are needed.
.env
.env.*
!.env.example
*.pem
*.key

# ---- Downloaded data -----------------------------------------------------
# Raw auction documents. Can be large and is re-fetchable; not source code.
# The application creates this directory at startup.
data/

# ---- Local PostgreSQL ----------------------------------------------------
# Portable server binaries and data directory, created by
# scripts/setup_postgres.py. Large, machine-specific and re-creatable.
.pgsql/

# ---- Python --------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Editors / OS --------------------------------------------------------
# The four .vscode files below are shared project configuration - the
# interpreter, the debug and task definitions - so everyone gets the same
# F5 and the same test runner. Anything else VS Code drops in there is
# personal (window layout, per-user overrides) and stays ignored.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- Logs ----------------------------------------------------------------
logs/
*.log
.neon
node_modules/
